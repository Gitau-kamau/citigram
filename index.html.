        .brand-gradient-bg {
            background: linear-gradient(135deg, #a855f7, #ec4899, #f43f5e);
        }

        .heart-animation {
            animation: heartPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes heartPop {
            0% { opacity: 0; transform: scale(0.3) rotate(-10deg); }
            50% { opacity: 1; transform: scale(1.3) rotate(0deg); }
            100% { opacity: 0; transform: scale(1) rotate(10deg); }
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
