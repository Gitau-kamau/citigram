                id: 2,
                userId: "u3",
                media: "https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?w=800",
                caption: "Late night coding session with the squad. Private preview shared exclusively with my Inner Circle! 💻🚀",
                circle: "inner",
                likedBy: ["u1"],
                comments: [{ userId: "u1", text: "Keep crushing it!" }],
                time: "4 hours ago"
            }
        ];

        // Helpers
        function loadState(key, fallback) {
            const data = localStorage.getItem(`citigram_${key}`);
            return data ? JSON.parse(data) : fallback;
        }

        function saveState(key, data) {
            localStorage.setItem(`citigram_${key}`, JSON.stringify(data));
        }

        let users = loadState('users', defaultUsers);
        let circles = loadState('circles', defaultCircles);
        let posts = loadState('posts', defaultPosts);
        let threads = loadState('threads', defaultThreads);
        let activeUserId = loadState('activeUserId', "u1");
        let activeThreadId = "t1";
        let activeCircleFilter = 'all';

        function getActiveUser() {
            return users.find(u => u.id === activeUserId) || users[0];
        }

        function syncActiveUserUI() {
            const activeUser = getActiveUser();
            document.getElementById('active-user-avatar').src = activeUser.avatar;
            document.getElementById('story-my-avatar').src = activeUser.avatar;
            document.getElementById('active-user-name').innerText = activeUser.name;
            document.getElementById('active-user-handle').innerText = `@${activeUser.handle}`;

            // Render Account Switcher Modal List
            const listContainer = document.getElementById('user-profiles-list');
            listContainer.innerHTML = users.map(u => `
                <div onclick="switchUserAccount('${u.id}')" class="flex items-center justify-between p-2.5 rounded-xl border ${u.id === activeUserId ? 'border-citigram-pink bg-citigram-darkHover' : 'border-citigram-darkBorder bg-citigram-darkCard'} cursor-pointer hover:border-citigram-pink transition">
                    <div class="flex items-center gap-3">
                        <img src="${u.avatar}" class="w-9 h-9 rounded-full object-cover">
                        <div>
                            <p class="text-xs font-bold">${u.name}</p>
                            <p class="text-[10px] text-gray-400">@${u.handle}</p>
                        </div>
                    </div>
                    ${u.id === activeUserId ? '<i class="fa-solid fa-circle-check text-citigram-pink text-sm"></i>' : ''}
                </div>
            `).join('');

            renderCircleFilters();
            renderPosts();
            renderChatThreads();
            renderChatMessages();
        }

        function switchUserAccount(userId) {
            activeUserId = userId;
            saveState('activeUserId', activeUserId);
            playAudioTone(640, 'sine', 0.15);
            closeModal('userSwitchModal');
            syncActiveUserUI();
        }

        // Messaging Engine Functions
        function renderChatThreads() {
            const container = document.getElementById('chat-threads-list');
            container.innerHTML = threads.map(t => {
                const partner = users.find(u => u.id === t.participantId) || { name: "User", avatar: "", handle: "user" };
                const lastMsg = t.messages[t.messages.length - 1] || { text: "No messages yet", time: "" };
                const isActive = t.id === activeThreadId;

                return `
                    <div onclick="selectChatThread('${t.id}')" class="p-3.5 flex items-center gap-3 cursor-pointer hover:bg-citigram-darkHover transition ${isActive ? 'bg-citigram-darkHover border-l-4 border-citigram-pink' : ''}">
                        <div class="relative">
                            <img src="${partner.avatar}" class="w-11 h-11 rounded-full object-cover">
                            <span class="w-3 h-3 bg-emerald-500 rounded-full border-2 border-citigram-darkCard absolute bottom-0 right-0"></span>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between">
                                <h4 class="font-bold text-xs truncate">${partner.name}</h4>
                                <span class="text-[10px] text-gray-400">${lastMsg.time}</span>
                            </div>
                            <p class="text-xs text-gray-400 truncate mt-0.5">${lastMsg.text}</p>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function selectChatThread(threadId) {
            activeThreadId = threadId;
            renderChatThreads();
            renderChatMessages();
        }

        function renderChatMessages() {
            const thread = threads.find(t => t.id === activeThreadId);
            if(!thread) return;

            const partner = users.find(u => u.id === thread.participantId) || { name: "User", avatar: "" };
            document.getElementById('chat-header-avatar').src = partner.avatar;
            document.getElementById('chat-header-name').innerText = partner.name;

            const messagesContainer = document.getElementById('chat-messages-container');
            messagesContainer.innerHTML = thread.messages.map(m => {
                const isMe = m.senderId === activeUserId;
                return `
                    <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'}">
                        <div class="max-w-[75%] ${isMe ? 'brand-gradient-bg text-white rounded-2xl rounded-br-none' : 'bg-citigram-darkHover text-gray-100 border border-citigram-darkBorder rounded-2xl rounded-bl-none'} p-3 text-xs shadow-md">
                            ${m.image ? `<img src="${m.image}" class="rounded-xl mb-2 max-h-48 w-full object-cover">` : ''}
                            <p>${m.text}</p>
                        </div>
                        <span class="text-[9px] text-gray-500 mt-1 px-1">${m.time}</span>
                    </div>
                `;
            }).join('');

            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function sendChatMessage() {
            const input = document.getElementById('chat-message-input');
            const text = input.value.trim();
            if(!text) return;

            const thread = threads.find(t => t.id === activeThreadId);
            if(thread) {
                const now = new Date();
                const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                thread.messages.push({ senderId: activeUserId, text, time: timeStr });
                saveState('threads', threads);
                input.value = '';
                playAudioTone(750, 'sine', 0.1);
                renderChatThreads();
                renderChatMessages();
            }
        }

        function handleChatKeyPress(e) {
            if(e.key === 'Enter') sendChatMessage();
        }

        function triggerPhotoUploadInChat() {
            const imgUrl = prompt("Enter Image URL to send in chat:");
            if(imgUrl) {
                const thread = threads.find(t => t.id === activeThreadId);
                if(thread) {
                    const now = new Date();
                    const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    thread.messages.push({ senderId: activeUserId, text: "Shared an image", image: imgUrl, time: timeStr });
                    saveState('threads', threads);
                    renderChatThreads();
                    renderChatMessages();
                }
            }
        }

        function renderCircleFilters() {
            const activeUser = getActiveUser();
            const filterContainer = document.getElementById('circles-filter-container');
            const targetSelect = document.getElementById('create-circle');

            let allowedCircles = circles.filter(c => c.id === 'public' || (c.members && c.members.includes(activeUser.id)));

            filterContainer.innerHTML = `
                <button onclick="setFilter('all', this)" class="circle-filter-pill ${activeCircleFilter === 'all' ? 'border-citigram-pink bg-citigram-darkHover' : 'border-citigram-darkBorder bg-citigram-darkCard'} px-4 py-2 rounded-full border text-sm font-semibold flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-globe text-citigram-pink"></i> All Feeds
                </button>
            ` + allowedCircles.map(c => `
                <button onclick="setFilter('${c.id}', this)" class="circle-filter-pill ${activeCircleFilter === c.id ? 'border-citigram-pink bg-citigram-darkHover' : 'border-citigram-darkBorder bg-citigram-darkCard'} px-4 py-2 rounded-full border text-sm font-medium flex items-center gap-2 whitespace-nowrap">
                    <span class="w-2.5 h-2.5 rounded-full bg-citigram-${c.color || 'pink'}"></span> ${c.name}
                </button>
            `).join('');

            targetSelect.innerHTML = allowedCircles.map(c => `<option value="${c.id}">${c.name}</option>`).join('');
        }

        function setFilter(circleId, el) {
            activeCircleFilter = circleId;
            renderCircleFilters();
            renderPosts();
        }

        function renderPosts() {
            const container = document.getElementById('posts-container');
            const activeUser = getActiveUser();

            let visiblePosts = posts.filter(post => {
                if(post.circle === 'public' || !post.circle) return true;
                const circleObj = circles.find(c => c.id === post.circle);
                return circleObj && circleObj.members && circleObj.members.includes(activeUser.id);
            });

            if(activeCircleFilter !== 'all') {
                visiblePosts = visiblePosts.filter(p => p.circle === activeCircleFilter);
            }

            container.innerHTML = visiblePosts.map(post => {
                const author = users.find(u => u.id === post.userId) || { name: "User", handle: "user", avatar: "" };
                const circleObj = circles.find(c => c.id === post.circle);
                const isLiked = post.likedBy && post.likedBy.includes(activeUser.id);

                return `
                    <article class="bg-citigram-darkCard border border-citigram-darkBorder rounded-2xl overflow-hidden space-y-3">
                        <div class="flex items-center justify-between p-4">
                            <div class="flex items-center gap-3">
                                <img src="${author.avatar}" class="w-10 h-10 rounded-full object-cover">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-sm">${author.name}</span>
                                        ${circleObj ? `<span class="text-[10px] px-2 py-0.5 rounded-full bg-citigram-${circleObj.color || 'pink'}/20 text-citigram-${circleObj.color || 'pink'} border border-citigram-${circleObj.color || 'pink'}/30 font-semibold">${circleObj.name}</span>` : ''}
                                    </div>
                                    <span class="text-xs text-gray-400">@${author.handle} • ${post.time}</span>
                                </div>
                            </div>
                            <i class="fa-solid fa-ellipsis text-gray-400 cursor-pointer"></i>
                        </div>

                        <div class="relative bg-black flex items-center justify-center min-h-[300px] max-h-[500px] overflow-hidden group cursor-pointer" ondblclick="doubleTapLikePost(${post.id}, this)">
                            <img src="${post.media}" class="w-full h-full object-cover">
                            <i class="fa-solid fa-heart text-6xl text-white drop-shadow-lg absolute opacity-0 pointer-events-none heart-icon-${post.id}"></i>
                        </div>

                        <div class="p-4 pt-1 space-y-2">
                            <div class="flex items-center justify-between text-xl pt-1">
                                <div class="flex items-center gap-4">
                                    <i onclick="toggleLikePost(${post.id})" class="fa-${isLiked ? 'solid text-red-500' : 'regular text-gray-200'} fa-heart cursor-pointer hover:scale-110 transition"></i>
                                    <i class="fa-regular fa-comment text-gray-200 cursor-pointer hover:scale-110 transition"></i>
                                    <i class="fa-regular fa-paper-plane text-gray-200 cursor-pointer hover:scale-110 transition"></i>
                                </div>
                                <i class="fa-regular fa-bookmark text-gray-200 cursor-pointer hover:scale-110 transition"></i>
                            </div>

                            <div class="font-semibold text-sm">${post.likedBy ? post.likedBy.length : 0} likes</div>

                            <div class="text-sm">
                                <span class="font-bold mr-2">${author.name}</span>
                                <span class="text-gray-300">${post.caption}</span>
                            </div>
                        </div>
                    </article>
                `;
            }).join('');
        }

        function switchTab(tab) {
            document.getElementById('tab-feed').classList.add('hidden');
            document.getElementById('tab-circles').classList.add('hidden');
            document.getElementById('tab-messages').classList.add('hidden');
            document.getElementById('tab-laugh').classList.add('hidden');

            document.getElementById(`tab-${tab}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('text-citigram-pink'));
            const activeBtn = document.getElementById(`nav-${tab}`);
            if(activeBtn) activeBtn.classList.add('text-citigram-pink');
        }

        function openModal(id) { document.getElementById(id).classList.remove('hidden'); }
        function closeModal(id) { document.getElementById(id).classList.add('hidden'); }
        function toggleTheme() { document.documentElement.classList.toggle('dark'); }

        // Initialize UI Engine
        syncActiveUserUI();
    </script>
</body>
</html>
